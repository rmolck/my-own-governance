# Required target checkout/worktree. The service user must own or be able to use it.
GOVERNANCE_REPOSITORY=/srv/my-own-governance/target

# Optional technical overrides (shown with generic reference-installation defaults).
GOVERNANCE_PYTHON=/usr/bin/python3
GOVERNANCE_ADAPTER=/opt/my-own-governance/adapter/codex_execution_adapter.py
GOVERNANCE_CODEX_EXECUTABLE=/usr/local/bin/codex
# GOVERNANCE_LOCK_FILE=/run/user/1000/my-own-governance.lock
# GOVERNANCE_ADAPTER_OUTPUT_DIR=/srv/my-own-governance/target/.git/codex-adapter
# Mechanical fresh-state and finalizer phase commands; deployment-specific.
# Values are JSON argv arrays; shell command strings are rejected.
# GOVERNANCE_REFRESH_ARGV=["/usr/local/bin/governance-refresh"]
# GOVERNANCE_FINALIZER_ARGV=["/usr/local/bin/governance-finalizer"]
# GOVERNANCE_RECOVERY_ARGV=["/usr/local/bin/governance-recovery"]
# GOVERNANCE_HOST_POST_WORKER_ARGV=["/usr/local/bin/governance-host-post-worker"]
# GOVERNANCE_EVIDENCE_FILE=/var/lib/my-own-governance/runs.jsonl
